// wlwidgets modules for waybar. In your waybar config add:
//     "include": ["wlwidgets.jsonc"],
// and put the module names in a modules list, e.g.
//     "modules-right": [ ..., "group/media", "custom/timer", "custom/sensors", "memory", "clock", "tray", "custom/notifications", "custom/wlwidgets" ]
// (custom/wlwidgets last: the main panel opens under it). In style.css:
//     @import "wlwidgets.css";
{
    // Quick-settings button. Turns red (with the percentage) when memory use
    // passes memory_warn_percent in ~/.config/wlwidgets/config.ini.
    "custom/wlwidgets": {
        "exec": "wlwidgets status",
        "return-type": "json",
        "format": "{}",
        "on-click": "wlwidgets toggle"
    },
    // Media: previous · track (click: play/pause, right click: the panel) · next.
    // Hidden while nothing is playing.
    "group/media": {
        "orientation": "horizontal",
        "modules": ["custom/media-prev", "custom/media", "custom/media-next"]
    },
    "custom/media": {
        "exec": "wlwidgets status media",
        "return-type": "json",
        "format": "{}",
        "on-click": "wlwidgets media play-pause",
        "on-click-right": "wlwidgets toggle",
        "on-scroll-up": "wlwidgets media previous",
        "on-scroll-down": "wlwidgets media next"
    },
    "custom/media-prev": {
        "exec": "wlwidgets status media prev",
        "return-type": "json",
        "format": "{}",
        "on-click": "wlwidgets media previous"
    },
    "custom/media-next": {
        "exec": "wlwidgets status media next",
        "return-type": "json",
        "format": "{}",
        "on-click": "wlwidgets media next"
    },
    // Running project timer (time tracking by workspace); opens the time panel.
    "custom/timer": {
        "exec": "wlwidgets status timer",
        "return-type": "json",
        "format": "{}",
        "on-click": "wlwidgets toggle time"
    },
    // Room temperature + CO2 from Tuya sensors; opens the sensors panel.
    "custom/sensors": {
        "exec": "wlwidgets status sensors",
        "return-type": "json",
        "format": "{}",
        "on-click": "wlwidgets toggle sensors"
    },
    // Bell with the unread count; opens the notification center. Right click
    // toggles do not disturb.
    "custom/notifications": {
        "exec": "wlwidgets status notifications",
        "return-type": "json",
        "format": "{}",
        "on-click": "wlwidgets toggle notifications",
        "on-click-right": "wlwidgets notify dnd"
    },
    // Waybar's own memory module, opening the system panel.
    "memory": {
        "interval": 5,
        "format": "{used:0.1f}<small> / {total:0.0f} GiB</small>  󰍛",
        "tooltip-format": "{percentage}% used · swap {swapUsed:0.1f} / {swapTotal:0.0f} GiB",
        "on-click": "wlwidgets toggle system"
    }
}
