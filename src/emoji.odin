// Emoji for the launcher (":smile", or the "emoji" panel): the table built
// into the binary (assets/emoji, generated by tools/emojigen from Unicode's
// emoji-test.txt and emojilib's keywords), search, colour pictures and
// typing the chosen one into the window that had focus.
//
// The UI fonts can't draw colour emoji (Fedora's Noto Color Emoji is COLRv1,
// which Dear ImGui's FreeType path doesn't render), so each emoji on screen
// is drawn once by Pango + cairo (dlopen'd; they shape ZWJ sequences, flags
// and skin tones too) into a small texture, like a notification icon.
package main

import "core:c"
import "core:dynlib"
import "core:fmt"
import "core:hash"
import "core:os"
import "core:strings"
import gl "vendor:OpenGL"

EMOJI_TSV :: #load("../assets/emoji/emoji.tsv", string)

Emoji :: struct {
	ch:       string,
	name:     string, // lower case, Unicode's ("thumbs up: medium skin tone")
	group:    string,
	keywords: string, // emojilib's, lower case, space separated
	tone:     bool,   // a skin-tone variant: only listed when asked for
	tones:    bool,   // has skin-tone variants
}

emoji_table: [dynamic]Emoji

// Words that ask for skin-tone variants.
@(private = "file")
TONE_WORDS := [?]string{"skin", "tone", "light", "medium", "dark"}

emoji_load :: proc() {
	if len(emoji_table) > 0 {return}
	text := EMOJI_TSV
	for line in strings.split_lines_iterator(&text) {
		f := strings.split_n(line, "\t", 4, context.temp_allocator)
		if len(f) != 4 {continue}
		e := Emoji{ch = f[0], name = f[1], group = f[2], keywords = f[3]} // views into the table
		e.tone = strings.contains(e.name, "skin tone")
		if e.tone && len(emoji_table) > 0 {
			// Variants follow their base: "thumbs up" then "thumbs up: light skin tone".
			for i := len(emoji_table) - 1; i >= max(0, len(emoji_table) - 30); i -= 1 {
				b := &emoji_table[i]
				if !b.tone && strings.has_prefix(e.name, b.name) {
					b.tones = true
					break
				}
			}
		}
		append(&emoji_table, e)
	}
}

// Score of an emoji for the query words (lower case); < 0: no match.
// Names count most, keywords less; variants only when a word asks for one.
emoji_score :: proc(e: ^Emoji, words: []string, tone_asked: bool) -> f32 {
	if e.tone && !tone_asked {return -1}
	total: f32 = 0
	for w in words {
		best := fuzzy_score(w, e.name, false)
		best = max(best, fuzzy_score(w, e.keywords, false) * 0.75)
		best = max(best, fuzzy_score(w, strings.to_lower(e.group, context.temp_allocator), false) * 0.3)
		if best < 0 {
			// Scattered letters only for longer words ("thmbs"): short ones match everything.
			if len(w) >= 4 {best = fuzzy_score(w, e.name) * 0.5}
			if best < 0 {return -1}
		}
		total += best
	}
	if e.tone {total -= 5} // the plain one first
	return total
}

emoji_tone_asked :: proc(words: []string) -> bool {
	for w in words {
		for t in TONE_WORDS {
			if strings.has_prefix(t, w) && len(w) >= 3 || w == t {return true}
		}
	}
	return false
}

emoji_use_id :: proc(e: ^Emoji) -> string {return strings.concatenate({"emoji:", e.ch}, context.temp_allocator)}

// Type the emoji into the window that gets focus back once the popup is
// gone (wtype); without wtype, or with copy_only, it goes to the clipboard.
emoji_insert :: proc(e: ^Emoji, copy_only: bool) {
	launcher_note_use(emoji_use_id(e))
	hide_requested = true
	if copy_only || !emoji_can_type() {
		run_async({"wl-copy", "--", e.ch})
		return
	}
	// The popup's keyboard focus has to go back to the window first.
	launch_detached({"sh", "-c", `sleep 0.25; exec wtype -- "$1"`, "sh", e.ch})
}

emoji_can_type :: proc() -> bool {
	@(static) known, ok: bool
	if !known {
		known = true
		_, ok = find_program("wtype")
	}
	return ok
}

find_program :: proc(name: string) -> (string, bool) {
	for dir in strings.split(posix_getenv("PATH"), ":", context.temp_allocator) {
		p := strings.concatenate({dir, "/", name}, context.temp_allocator)
		if os.exists(p) {return p, true}
	}
	return "", false
}

// ---- Pictures (Pango + cairo) ----------------------------------------------------------------

@(private = "file")
Pango_Rect :: struct {x, y, w, h: c.int}

@(private = "file")
pango: struct {
	tried, ok:          bool,
	surface_create:     proc "c" (format: c.int, w, h: c.int) -> rawptr,
	cairo_create:       proc "c" (surface: rawptr) -> rawptr,
	cairo_destroy:      proc "c" (cr: rawptr),
	move_to:            proc "c" (cr: rawptr, x, y: f64),
	surface_flush:      proc "c" (surface: rawptr),
	surface_data:       proc "c" (surface: rawptr) -> [^]u8,
	surface_stride:     proc "c" (surface: rawptr) -> c.int,
	surface_destroy:    proc "c" (surface: rawptr),
	create_layout:      proc "c" (cr: rawptr) -> rawptr,
	show_layout:        proc "c" (cr: rawptr, layout: rawptr),
	desc_from_string:   proc "c" (s: cstring) -> rawptr,
	desc_free:          proc "c" (desc: rawptr),
	set_desc:           proc "c" (layout: rawptr, desc: rawptr),
	set_text:           proc "c" (layout: rawptr, text: cstring, length: c.int),
	pixel_extents:      proc "c" (layout: rawptr, ink, logical: ^Pango_Rect),
	object_unref:       proc "c" (obj: rawptr),
	desc:               rawptr,
}

@(private = "file")
pango_load :: proc() -> bool {
	if pango.tried {return pango.ok}
	pango.tried = true
	cairo, ok1 := dynlib.load_library("libcairo.so.2")
	pc, ok2 := dynlib.load_library("libpangocairo-1.0.so.0")
	pg, ok3 := dynlib.load_library("libpango-1.0.so.0")
	gob, ok4 := dynlib.load_library("libgobject-2.0.so.0")
	if !(ok1 && ok2 && ok3 && ok4) {return false}
	sym :: proc(lib: dynlib.Library, name: string) -> rawptr {p, _ := dynlib.symbol_address(lib, name); return p}
	pango.surface_create = auto_cast sym(cairo, "cairo_image_surface_create")
	pango.cairo_create = auto_cast sym(cairo, "cairo_create")
	pango.cairo_destroy = auto_cast sym(cairo, "cairo_destroy")
	pango.move_to = auto_cast sym(cairo, "cairo_move_to")
	pango.surface_flush = auto_cast sym(cairo, "cairo_surface_flush")
	pango.surface_data = auto_cast sym(cairo, "cairo_image_surface_get_data")
	pango.surface_stride = auto_cast sym(cairo, "cairo_image_surface_get_stride")
	pango.surface_destroy = auto_cast sym(cairo, "cairo_surface_destroy")
	pango.create_layout = auto_cast sym(pc, "pango_cairo_create_layout")
	pango.show_layout = auto_cast sym(pc, "pango_cairo_show_layout")
	pango.desc_from_string = auto_cast sym(pg, "pango_font_description_from_string")
	pango.desc_free = auto_cast sym(pg, "pango_font_description_free")
	pango.set_desc = auto_cast sym(pg, "pango_layout_set_font_description")
	pango.set_text = auto_cast sym(pg, "pango_layout_set_text")
	pango.pixel_extents = auto_cast sym(pg, "pango_layout_get_pixel_extents")
	pango.object_unref = auto_cast sym(gob, "g_object_unref")
	pango.ok =
		pango.surface_create != nil && pango.cairo_create != nil && pango.cairo_destroy != nil && pango.move_to != nil &&
		pango.surface_flush != nil && pango.surface_data != nil && pango.surface_stride != nil && pango.surface_destroy != nil &&
		pango.create_layout != nil && pango.show_layout != nil && pango.desc_from_string != nil && pango.desc_free != nil &&
		pango.set_desc != nil && pango.set_text != nil && pango.pixel_extents != nil && pango.object_unref != nil
	if pango.ok {
		// Size in pixels; "emoji" is fontconfig's family for the colour emoji font.
		pango.desc = pango.desc_from_string(fmt.ctprintf("Noto Color Emoji, emoji %dpx", ICON_PX * 3 / 4))
	}
	return pango.ok
}

// Drawn emoji, by text. Kept small: a long scroll through the table drops
// them all and draws the visible ones again.
@(private = "file")
emoji_pics: map[string]^Notif_Icon

@(private = "file")
EMOJI_PICS_MAX :: 250

// The emoji drawn into an ICON_PX square (premultiplied ARGB), or nil when
// there's no Pango or no font has it.
emoji_picture :: proc(e: ^Emoji) -> ^Notif_Icon {
	if ic, ok := emoji_pics[e.ch]; ok {return ic}
	ic: ^Notif_Icon
	defer emoji_pics[e.ch] = ic
	if !pango_load() {return nil}
	surf := pango.surface_create(0, ICON_PX, ICON_PX) // CAIRO_FORMAT_ARGB32
	if surf == nil {return nil}
	defer pango.surface_destroy(surf)
	cr := pango.cairo_create(surf)
	layout := pango.create_layout(cr)
	pango.set_desc(layout, pango.desc)
	pango.set_text(layout, cstr(e.ch), -1)
	ink, logical: Pango_Rect
	pango.pixel_extents(layout, &ink, &logical)
	// Centre the ink.
	pango.move_to(cr, f64(ICON_PX - ink.w) / 2 - f64(ink.x), f64(ICON_PX - ink.h) / 2 - f64(ink.y))
	pango.show_layout(cr, layout)
	pango.object_unref(layout)
	pango.cairo_destroy(cr)
	pango.surface_flush(surf)
	data := pango.surface_data(surf)
	stride := int(pango.surface_stride(surf))
	px := make([]u32, ICON_PX * ICON_PX)
	any := false
	for y in 0 ..< ICON_PX {
		row := ([^]u32)(&data[y * stride])
		for x in 0 ..< ICON_PX {
			px[y * ICON_PX + x] = row[x]
			if row[x] != 0 {any = true}
		}
	}
	if !any {
		delete(px)
		return nil
	}
	ic = new(Notif_Icon)
	ic^ = {key = hash.fnv64a(transmute([]u8)e.ch), size = ICON_PX, px = px}
	return ic
}

// The picture if it was drawn before (nil: no font has it).
emoji_cached :: proc(e: ^Emoji) -> (^Notif_Icon, bool) {
	ic, ok := emoji_pics[e.ch]
	return ic, ok
}

// Between frames: past the limit, start over (the visible ones are drawn
// again, a few per frame).
emoji_pictures_trim :: proc() {
	if len(emoji_pics) > EMOJI_PICS_MAX {emoji_pictures_drop()}
}

// Free the pictures and their textures (GL context current).
emoji_pictures_drop :: proc() {
	for _, ic in emoji_pics {
		if ic == nil {continue}
		if ic.tex != 0 {gl.DeleteTextures(1, &ic.tex)}
		delete(ic.px)
		free(ic)
	}
	clear(&emoji_pics)
}

// The GL context went away: the textures went with it.
emoji_textures_reset :: proc() {
	for _, ic in emoji_pics {if ic != nil {ic.tex = 0}}
}
