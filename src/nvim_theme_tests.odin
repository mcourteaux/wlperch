// nvim_set_background: only the 'background' line of the nvim theme file changes.
package main

import "core:testing"

@(test)
test_nvim_set_background :: proc(t: ^testing.T) {
	cases := [?]struct {in_, mode, want: string} {
		{"\"Generated by wlperch theme\nset background=dark\ncolorscheme gruvbox\n", "light", "\"Generated by wlperch theme\nset background=light\ncolorscheme gruvbox\n"},
		{"colorscheme tokyonight\n", "light", "set background=light\ncolorscheme tokyonight\n"},
		{"\" my colours\ncolorscheme catppuccin", "dark", "\" my colours\nset background=dark\ncolorscheme catppuccin\n"},
		{"", "dark", "set background=dark\n"},
		{"set bg=light\nset background=light\ncolorscheme x\n", "dark", "set background=dark\ncolorscheme x\n"},
		{"set background=dark\ncolorscheme x\n", "dark", "set background=dark\ncolorscheme x\n"},
	}
	for c in cases {
		testing.expect_value(t, nvim_set_background(c.in_, c.mode), c.want)
	}
}
