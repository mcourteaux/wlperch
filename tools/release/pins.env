# Pinned inputs of a wlperch release build (sourced by release.sh).
# Every download is checked against a hash below before it is used. To bump
# a pin, see tools/release/README.md ("Bumping pins").

# ---- Odin compiler: official prebuilt release tarball ---------------------
# Tag dev-2026-10 is commit 84bc3fc; `odin version` prints
# dev-2026-10-nightly:84bc3fc. The tarball for the build machine's own arch
# is used (Odin cross-compiles to both targets).
ODIN_TAG=dev-2026-10
ODIN_COMMIT=84bc3fc2100b0f7880a3af37f71bccdcda41c6f9
ODIN_VERSION_STRING=dev-2026-10-nightly:84bc3fc
ODIN_URL_BASE=https://github.com/odin-lang/Odin/releases/download/dev-2026-10
ODIN_FILE_amd64=odin-linux-amd64-dev-2026-10.tar.gz
ODIN_SHA256_amd64=c3c8b095621fd0c75f7f73e3a0829f1b4d45324225f20ba11ed8dc4da310a8ab
ODIN_FILE_arm64=odin-linux-arm64-dev-2026-10.tar.gz
ODIN_SHA256_arm64=99c43e9670a285901d6cfee5f56197b74c7d6f7c537b35ecba0c1b44ac2e4df8

# ---- Dear ImGui: odin-imgui bindings + the Dear ImGui sources they target -
# Git commit ids are content hashes; the fetched commit must match exactly.
# Keep ODIN_IMGUI_COMMIT equal to IMGUI_COMMIT in build.sh. IMGUI_TAG is
# `imgui_version` in odin-imgui's build.py at that commit.
ODIN_IMGUI_REPO=https://gitlab.com/L-4/odin-imgui.git
ODIN_IMGUI_COMMIT=a116eb1ceaa6acde60219efdd56bf6c2e1aedf4c
IMGUI_REPO=https://github.com/ocornut/imgui.git
IMGUI_TAG=v1.92.8-docking
IMGUI_COMMIT=b61e56346a92cfcaf1f43a545ca37b0b32239654

# ---- Debian 12 (bookworm) sysroot, from a fixed snapshot ------------------
# Release (Debian 12.15) is pinned by hash; it vouches for Packages.xz, which
# vouches for every .deb. The Release signature is also checked with gpgv
# when available (see README).
DEBIAN_SNAPSHOT=20261020T000000Z
DEBIAN_MIRROR=https://snapshot.debian.org/archive/debian
DEBIAN_SUITE=bookworm
DEBIAN_RELEASE_SHA256=abcf5882746e0f68171f41adbb4ac01b74b49d62d203379befb9265804311a4f
# Headers and link-time libraries. Only the libraries' sonames end up in the
# binary; they bound the glibc / libstdc++ symbol versions it can need.
DEBIAN_PACKAGES="libc6 libc6-dev linux-libc-dev libgcc-12-dev libgcc-s1 libstdc++6 libstdc++-12-dev
libwayland-client0 libwayland-egl1 libwayland-dev libegl1 libegl-dev libglvnd0 libgl-dev libglx0 libglx-dev
libxkbcommon0 libxkbcommon-dev libsystemd0 libsystemd-dev libpam0g libpam0g-dev
libfontconfig1 libfontconfig-dev libfreetype6 libfreetype-dev libpng16-16 zlib1g libbrotli1 libexpat1 libbz2-1.0
libcap2 libgcrypt20 liblz4-1 liblzma5 libzstd1 libgpg-error0 libaudit1 libcap-ng0 libffi8 libasan8 libtsan2
libubsan1 liblsan0 libitm1 libatomic1 libgomp1"
# Used only to test-run foreign-arch binaries when no qemu-<cpu>-static is
# installed, and to check the Release signature.
DEBIAN_QEMU_PACKAGE=qemu-user-static
DEBIAN_KEYRING_PACKAGE=debian-archive-keyring

# ---- Release requirements -------------------------------------------------
GLIBC_MAX=2.34
# Shared libraries the binary may depend on (readelf -d NEEDED).
ALLOWED_NEEDED="libEGL.so.1 libsystemd.so.0 libpam.so.0 libfontconfig.so.1 libwayland-client.so.0
libwayland-egl.so.1 libxkbcommon.so.0 libstdc++.so.6 libm.so.6 libc.so.6 libfreetype.so.6
ld-linux-x86-64.so.2 ld-linux-aarch64.so.1"
# The host clang is the linker driver and compiles stb / ImGui; it is
# recorded in the binary's .comment section. A different major version gives
# a working binary but not a bit-identical one (warning only).
CLANG_MAJOR=22
